# Copy this file to `.env` and fill in the values. `.env` is git-ignored.

# Base URL for the backend API (see docs/API.md). Include the /api/v1 suffix.
# Local backend example:  http://localhost:8000/api/v1
VITE_API_URL=https://collivra-backend.onrender.com/api/v1

# Public OAuth client identifiers. Never place provider secrets in Vite env files.
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
