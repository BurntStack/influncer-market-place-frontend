# Copy this file to `.env.local` and fill in the values. `.env.local` is git-ignored.

# Backend API base URL (include the /api/v1 suffix).
# Leave blank while the backend is not yet deployed — the app runs fully on mock data.
VITE_API_URL=

# Supabase project credentials (required for Google / Apple OAuth).
# Find these in your Supabase project → Settings → API.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-public-key>
